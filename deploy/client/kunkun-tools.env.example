# kunkun-tools env —— 解压后与 kunkun-tools.bat 同目录（D:\WebGpt\kunkun-tools.env）
#
# 管理员令牌（唯一必填）：用于客户端一侧注册 Runner（方案 B，pair 命令）。
# 把下面 <填这里> 替换成服务器 /etc/webcodex/webcodex.env 里的 WEBCODEX_TOKEN 值，
# 之后 kunkun-tools.bat pair 会自动读取，无需再手动 set-server-token。
WEBCODEX_TOKEN=<填这里>

# 可选：不填则使用 kunkun-tools.bat set-server / set-allowed-root 的缓存值
# WEBCODEX_SERVER_URL=https://chatgpt.kunkun.chat
# WEBCODEX_USERNAME=saigou
# WEBCODEX_ALLOWED_ROOT=D:\work

# 可选：add-mcp 签发 wc_pat 用的账号凭据（saigou 的 wc_pat_...）；
# 不填则自动回退使用上面的 WEBCODEX_TOKEN（服务器管理员令牌可直接替 saigou 注册）
# WEBCODEX_BOOTSTRAP=wc_pat_...
