# WebGpt client env —— 解压后与 webgpt-client.bat 同目录（D:\WebGpt\webgpt.env）
#
# 管理员令牌（唯一必填）：用于客户端一侧注册 Runner（方案 B，pair 命令）。
# 把下面 <填这里> 替换成服务器 /etc/webcodex/webcodex.env 里的 WEBCODEX_TOKEN 值，
# 之后 webgpt-client.bat pair 会自动读取，无需再手动 set-server-token。
WEBCODEX_TOKEN=<填这里>

# 可选：不填则使用 webgpt-client.bat set-server / set-allowed-root 的缓存值
# WEBCODEX_SERVER_URL=https://chatgpt.kunkun.chat
# WEBCODEX_USERNAME=saigou
# WEBCODEX_ALLOWED_ROOT=D:\work
